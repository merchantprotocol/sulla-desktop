{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "outDir": "dist",
    "rootDir": "../..",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "baseUrl": "../..",
    "paths": {
      "@pkg/*": [
        "pkg/sulla-desktop/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../pkg/sulla-desktop/runtime/containerRuntime.ts",
    "../../packages/workflow-engine/src/**/*.ts",
    "../../packages/runtime-protocol/src/**/*.ts"
  ]
}
