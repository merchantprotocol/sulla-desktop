{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "outDir": "dist",
    "rootDir": "../..",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": "../..",
    "paths": { "@pkg/*": ["pkg/rancher-desktop/*"] }
  },
  "include": [
    "src/**/*.ts",
    "../../pkg/rancher-desktop/agent/workflow/WorkflowPlaybook.ts",
    "../../pkg/rancher-desktop/agent/workflow/types.ts",
    "../../pkg/rancher-desktop/pages/editor/workflow/types.ts",
    "../../pkg/rancher-desktop/runtime/containerRuntime.ts"
  ]
}
