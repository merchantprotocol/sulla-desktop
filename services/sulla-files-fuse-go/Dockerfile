# Build context: the repository root (like the other services/*/Dockerfile).
ARG GO_IMAGE=golang:1.25-alpine
ARG BASE=alpine:3.24

FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY services/sulla-files-fuse-go/go.mod services/sulla-files-fuse-go/go.sum ./
RUN go mod download
COPY services/sulla-files-fuse-go/ ./
ARG VERSION=dev
RUN CGO_ENABLED=0 GOWORK=off go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/sulla-files-fuse ./cmd/sulla-files-fuse

FROM ${BASE}
# One static binary: entrypoint, daemon and healthcheck. `python3` is an argv[0]
# shim so the compose HEALTHCHECK generated by already-installed apps
# (`python3 -c "..."`) keeps working without an interpreter in the image.
COPY --from=build /out/sulla-files-fuse /usr/local/bin/sulla-files-fuse
RUN ln -s sulla-files-fuse /usr/local/bin/python3 \
 && ln -s sulla-files-fuse /usr/local/bin/sulla-files-fuse-entrypoint \
 && install -d -m 0700 /run/sulla-files-fuse /mnt/sulla-files /var/spool/sulla-files-fuse
ENTRYPOINT ["/usr/local/bin/sulla-files-fuse"]
CMD ["run"]
