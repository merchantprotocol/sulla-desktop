{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "../..",
    "outDir": "dist",
    "baseUrl": "../..",
    "paths": {
      "@pkg/*": [
        "pkg/sulla-desktop/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "../../pkg/sulla-desktop/runtime/desktopExecutor.ts",
    "../../pkg/sulla-desktop/agent/tools/executionContext.ts",
    "../../pkg/sulla-desktop/agent/tools/executionTargets.ts",
    "../../packages/runtime-protocol/src/**/*.ts",
    "../../packages/relay-protocol/src/**/*.ts"
  ]
}
