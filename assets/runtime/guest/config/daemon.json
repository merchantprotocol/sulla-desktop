{
  "min-api-version": "1.41",
  "features": { "containerd-snapshotter": true },
  "builder": {
    "gc": {
      "enabled": true,
      "defaultKeepStorage": "1GB",
      "policy": [
        { "reservedSpace": "1GB", "keepDuration": ["168h"] },
        { "reservedSpace": "1GB" },
        { "reservedSpace": "1GB", "all": true }
      ]
    }
  },
  "iptables": true,
  "storage-driver": "overlayfs",
  "userland-proxy": true,
  "log-driver": "json-file",
  "log-opts": { "max-size": "10m", "max-file": "3" }
}
