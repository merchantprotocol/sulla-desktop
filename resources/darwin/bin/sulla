#!/bin/sh
# sulla — unified CLI for Sulla Desktop
#
# Proxy call:    sulla <account_id>/<slug> '<json>'
# Tool call:     sulla <category>/<tool> '<json>'
# MCP call:      sulla <account_id>/mcp/<tool> '<json>'
# Bare tool:     sulla <tool_name> '<json>'

# Load defaults from environment file; existing env vars win.
if [ -f /etc/sulla-env ]; then
  [ -z "$SULLA_API_TOKEN" ] || _existing_token="$SULLA_API_TOKEN"
  [ -z "$SULLA_HOST" ]      || _existing_host="$SULLA_HOST"
  [ -z "$SULLA_TOOL_API_URL" ] || _existing_tool_api_url="$SULLA_TOOL_API_URL"
  . /etc/sulla-env
  [ -n "$_existing_token" ] && SULLA_API_TOKEN="$_existing_token"
  [ -n "$_existing_host" ]  && SULLA_HOST="$_existing_host"
  [ -n "$_existing_tool_api_url" ] && SULLA_TOOL_API_URL="$_existing_tool_api_url"
  unset _existing_token _existing_host _existing_tool_api_url
  export SULLA_API_TOKEN SULLA_HOST SULLA_TOOL_API_URL
fi

SOCKET="/tmp/sulla-tools.sock"

# On the Mac, Desktop publishes its actual port and bearer in a private file.
# Agent containers and explicitly configured endpoints use their existing routes.
LOCAL_DESKTOP=0
DISCOVERED_BEARER=0
if [ -z "$SULLA_TOOL_API_URL" ] && [ -z "$SULLA_HOST" ] && [ ! -S "$SOCKET" ] && [ "$(uname -s)" = Darwin ]; then
  LOCAL_DESKTOP=1
  case "$SULLA_INSTANCE" in
    '') instance_suffix='' ;;
    *[!A-Za-z0-9_-]*) printf '%s\n' 'Invalid SULLA_INSTANCE.' >&2; exit 1 ;;
    *) instance_suffix="-$SULLA_INSTANCE" ;;
  esac
  descriptor="$HOME/Library/Application Support/sulla-desktop${instance_suffix}/chat-api-token.json"
  port=$(/usr/bin/plutil -extract port raw -expect integer -o - -- "$descriptor" 2>/dev/null)
  case "$port" in
    ''|*[!0-9]*|??????*) ;;
    *)
      if [ "$port" -ge 1 ] && [ "$port" -le 65535 ]; then
        SULLA_TOOL_API_URL="http://127.0.0.1:$port"
      fi
      ;;
  esac
  if [ -z "$SULLA_API_TOKEN" ]; then
    DISCOVERED_BEARER=1
    desktop_pid=$(/usr/bin/plutil -extract pid raw -expect integer -o - -- "$descriptor" 2>/dev/null)
    SULLA_API_TOKEN=$(/usr/bin/plutil -extract token raw -expect string -o - -- "$descriptor" 2>/dev/null)
  fi
fi

# The agent's tool session binds CLI calls to its thread (check-ins,
# return_result, contracts). Some agent shells don't pass it down — Codex's
# exec kernel drops it on resumed turns — so take it from the nearest
# ancestor process that has it (the agent process itself always does).
if [ -z "$SULLA_TOOL_SESSION" ] && [ -r "/proc/$$/status" ]; then
  _p=$PPID; _n=0
  while [ -n "$_p" ] && [ "$_p" -gt 1 ] && [ "$_n" -lt 25 ]; do
    _s=$(tr '\0' '\n' < "/proc/$_p/environ" 2>/dev/null | sed -n 's/^SULLA_TOOL_SESSION=//p' | head -n 1)
    if [ -n "$_s" ]; then SULLA_TOOL_SESSION="$_s"; export SULLA_TOOL_SESSION; break; fi
    _p=$(sed -n 's/^PPid:[[:space:]]*//p' "/proc/$_p/status" 2>/dev/null); _n=$((_n + 1))
  done
  unset _p _n _s
fi
SULLA_HOST="${SULLA_HOST:-host.sulla.internal}"
SULLA_TOOL_API_URL="${SULLA_TOOL_API_URL%/}"
FIRST="$1"
BODY="$2"
BODY_FILE=""
BODY_FROM_STDIN=""
DATA_FLAG="-d"

# Keep large JSON out of argv: Linux limits individual arguments to 128 KiB.
# A missing body is stdin-backed only for a piped invocation; interactive calls
# retain the historical default of {}.
if [ "$BODY" = "-" ]; then
  BODY_FROM_STDIN=1
elif [ "${BODY#@}" != "$BODY" ]; then
  BODY_FILE="${BODY#@}"
elif [ -z "$BODY" ] && [ ! -t 0 ]; then
  BODY_FROM_STDIN=1
fi

tool_api_curl() {
  _path="$1"
  shift
  if [ "$LOCAL_DESKTOP" = 1 ]; then
    if [ "$DISCOVERED_BEARER" = 1 ]; then
      case "$desktop_pid" in ''|0*|*[!0-9]*) desktop_pid='' ;; esac
      if [ -z "$SULLA_TOOL_API_URL" ] || [ -z "$desktop_pid" ] || ! kill -0 "$desktop_pid" 2>/dev/null ||
         ! owner=$(/usr/sbin/lsof -nP -i4TCP:"$port" -sTCP:LISTEN -t 2>/dev/null) || [ "$owner" != "$desktop_pid" ]; then
        printf '%s\n' 'Sulla Desktop is not running. Start it and retry.' >&2
        return 69
      fi
    fi
    case "$SULLA_API_TOKEN" in
      ''|*[!A-Za-z0-9._~+/=-]*)
        printf '%s\n' 'Sulla Desktop credentials are unavailable. Start Sulla Desktop and retry.' >&2
        return 1
        ;;
    esac
    if [ -z "$SULLA_TOOL_API_URL" ]; then
      printf '%s\n' 'Sulla Desktop port is unavailable. Start Sulla Desktop and retry.' >&2
      return 1
    fi
    # Ignore proxy and curl configuration for this credential. Keep it off argv.
    exec curl -q --noproxy '*' --header @/dev/fd/3 "$@" "${SULLA_TOOL_API_URL}${_path}" 3<<AUTH
Authorization: Bearer $SULLA_API_TOKEN
AUTH
  fi

  if [ -n "$SULLA_API_TOKEN" ]; then
    set -- -H "Authorization: Bearer $SULLA_API_TOKEN" "$@"
  fi
  if [ -n "$SULLA_TOOL_API_URL" ]; then
    exec curl "$@" "${SULLA_TOOL_API_URL}${_path}"
  elif [ -S "$SOCKET" ]; then
    exec curl --unix-socket "$SOCKET" "$@" "http://localhost${_path}"
  else
    exec curl "$@" "http://${SULLA_HOST}:3000${_path}"
  fi
}

is_tool_category() {
  _status=$(tool_api_curl "/v1/tools/help/$1" -sS --max-time 2 -o /dev/null -w '%{http_code}') || exit $?
  case "$_status" in
    2[0-9][0-9]) return 0 ;;
    404) return 1 ;;
    *) printf 'Sulla tool discovery failed (HTTP %s).\n' "$_status" >&2; exit 22 ;;
  esac
}

# ── Help & discovery ─────────────────────────────────────────────
# sulla --help | sulla -h | sulla help | sulla (no args) — query the backend
# for the live category list so new categories surface without needing a
# CLI rebuild.
if [ -z "$FIRST" ] || [ "$FIRST" = "--help" ] || [ "$FIRST" = "-h" ] || [ "$FIRST" = "help" ]; then
  _help_url="/v1/tools/help"
  _live=$(tool_api_curl "$_help_url" -fsS --max-time 2 2>/dev/null)
  if [ "$?" = 69 ]; then printf '%s\n' 'Sulla Desktop is not running. Start it and retry.' >&2; exit 69; fi
  if [ -n "$_live" ] && printf '%s' "$_live" | grep -q "Categories"; then
    printf '%s\n' "$_live"
    printf '\nRun "sulla <category> --help" or "sulla <category>" to list tools in a category.\n'
    exit 0
  fi
  cat <<'HELP'
sulla — unified CLI for Sulla Desktop

Usage:
  sulla <category>/<tool> '<json>'           # tool call
  sulla <category>/<tool> - < payload.json    # read JSON from stdin
  sulla <category>/<tool> @/path/payload.json  # read JSON from a file
  sulla <category> --help                    # list tools in a category
  sulla <account_id>/<slug> '<json>'         # proxy call
  sulla <account>/mcp/<tool> '<json>'        # MCP tool
  sulla <tool_name> '<json>'                 # bare tool

Flags:
  --help, -h    Show this help or category-specific help

The live tool catalog is unavailable. Start Sulla Desktop and retry to list categories.
Run "sulla vault/list_accounts '{}'" to discover proxy accounts.
HELP
  exit 0
# sulla <category> --help  (e.g. sulla bridge --help)
elif [ "$BODY" = "--help" ] || [ "$BODY" = "-h" ]; then
  METHOD="GET"
  URL="/v1/tools/help/${FIRST}"
  BODY=""
else
  METHOD="POST"

  if [ -z "$BODY" ] && [ -z "$BODY_FILE" ] && [ -z "$BODY_FROM_STDIN" ]; then
    BODY='{}'
  fi
  if [ -n "$BODY_FILE" ]; then
    DATA_FLAG="--data-binary"
    DATA_ARG="@$BODY_FILE"
  elif [ -n "$BODY_FROM_STDIN" ]; then
    DATA_FLAG="--data-binary"
    DATA_ARG='@-'
  else
    DATA_ARG="$BODY"
  fi

  case "$FIRST" in
    */mcp/*)
      # MCP tool: account_id/mcp/tool_name
      ACCOUNT="${FIRST%%/mcp/*}"
      TOOL="${FIRST##*/mcp/}"
      URL="/v1/tools/${ACCOUNT}/mcp/${TOOL}/call"
      ;;
    */*)
      # Has a slash — check if it's a tool category or a proxy call
      PART1="${FIRST%%/*}"
      PART2="${FIRST#*/}"
      # Blocked from CLI — native agent tool only, prevents circular tool calling
      if [ "$PART1/$PART2" = "meta/exec" ]; then
        echo '{"error":"Blocked: do not call sulla CLI for this function. Preventing circular tool calling. Use the native exec tool instead."}' >&2
        exit 1
      fi
      # Desktop is a bundled first-party category. Route it internally even when
      # the remote catalog is stale or temporarily unavailable during startup.
      if [ "$PART1" = "desktop" ] || is_tool_category "$PART1"; then
        # Tool call: category/tool_name
        URL="/v1/tools/internal/${PART1}/${PART2}/call"
      else
        # Proxy call: account_id/slug
        URL="/v1/proxy/${PART1}/${PART2}"
      fi
      ;;
    *)
      # Bare name with no slash — check if it's a category (→ help) or a bare tool
      if is_tool_category "$FIRST"; then
        METHOD="GET"
        URL="/v1/tools/help/${FIRST}"
        BODY=""
      else
        # Bare tool name — route as internal with integrations as default slug
        URL="/v1/tools/internal/integrations/${FIRST}/call"
      fi
      ;;
  esac
fi

# ── Execute ──────────────────────────────────────────────────────
if [ "$METHOD" = "GET" ]; then
  tool_api_curl "$URL" -sS --fail-with-body
else
  tool_api_curl "$URL" -sS --fail-with-body -X POST \
    -H "Content-Type: application/json" \
    -H "X-Sulla-Tool-Session: ${SULLA_TOOL_SESSION:-}" \
    "$DATA_FLAG" "$DATA_ARG"
fi
