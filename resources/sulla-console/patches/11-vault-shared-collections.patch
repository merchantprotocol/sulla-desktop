+        }
+        let name = 'Shared collection';
+        try {
+          name = dec.decode(open(c.encryptedName, orgKey, 'sulla:collection-name:v1'));
+        } catch {
+          // keep the generic name
+        }
+        out.set(c.collectionId, { key, name });
+      }
+    } finally {
+      orgKey.fill(0);
+    }
+    return out;
+  }
