worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 1024; }

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log /dev/stdout;
  sendfile on;
  client_max_body_size 2g;
  proxy_read_timeout 300s;
  proxy_send_timeout 300s;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }

  server {
    listen 8787;
    server_name _;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options SAMEORIGIN always;
    resolver ${DNS_RESOLVER} ipv6=off valid=10s;
    set $console_upstream ${SULLA_CONSOLE_UPSTREAM};
    set $accounts_upstream http://sulla-accounts:3020;
    set $identity_upstream http://sulla-accounts:8080;
    set $vault_upstream http://sulla-vault:8787;
    set $files_upstream http://sulla-files:8792;
    set $agents_upstream http://sulla-agents:8789;
    set $workflows_upstream http://sulla-workflows:8788;
    set $relay_upstream http://sulla-relay:8790;
    set $vault_public_upstream http://sulla-vault:8787;

    location /accounts-api/v1/web/ { rewrite ^/accounts-api/(.*)$ /$1 break; proxy_pass $accounts_upstream; include /tmp/sulla-proxy-params.conf; }
    location /accounts-api/ { return 404; }
    location ^~ /auth/realms/sulla/ { proxy_pass $identity_upstream; include /tmp/sulla-proxy-params.conf; }
    location ^~ /auth/resources/ { proxy_pass $identity_upstream; include /tmp/sulla-proxy-params.conf; }
    location ^~ /auth/ { return 404; }
    location /services/accounts/ { rewrite ^/services/accounts/(.*)$ /ui/$1 break; proxy_pass $accounts_upstream; include /tmp/sulla-proxy-params.conf; }
    location /services/vault/api/ { rewrite ^/services/vault/api/(.*)$ /v1/$1 break; proxy_pass $vault_upstream; include /tmp/sulla-proxy-params.conf; }
    location /services/vault/ { rewrite ^/services/vault/(.*)$ /ui/$1 break; proxy_pass $vault_upstream; include /tmp/sulla-proxy-params.conf; }
    location ~ ^/services/files/api/(?:healthz$|v1/(?:local|desktop|bootstrap|admin)(?:/|$)) { return 404; }
    location /services/files/api/v1/ { rewrite ^/services/files/api/v1/(.*)$ /v1/$1 break; proxy_pass $files_upstream; proxy_buffering off; proxy_request_buffering off; proxy_cache off; include /tmp/sulla-proxy-params.conf; }
    location /services/files/api/ { return 404; }
    location /services/files/ { rewrite ^/services/files/(.*)$ /ui/$1 break; proxy_pass $files_upstream; include /tmp/sulla-proxy-params.conf; }
    location /services/agents/api/ { rewrite ^/services/agents/api/(.*)$ /v1/$1 break; proxy_pass $agents_upstream; include /tmp/sulla-proxy-params.conf; }
    location /services/agents/ { rewrite ^/services/agents/(.*)$ /ui/$1 break; proxy_pass $agents_upstream; include /tmp/sulla-proxy-params.conf; }
    location /services/workflows/api/ { rewrite ^/services/workflows/api/(.*)$ /v1/$1 break; proxy_pass $workflows_upstream; include /tmp/sulla-proxy-params.conf; }
    location /services/workflows/ { rewrite ^/services/workflows/(.*)$ /ui/$1 break; proxy_pass $workflows_upstream; include /tmp/sulla-proxy-params.conf; }
    location = / { return 308 /console/; }
    location ^~ /api/ { proxy_pass $console_upstream; include /tmp/sulla-proxy-params.conf; }
    location ^~ /relay/ { proxy_pass $relay_upstream; include /tmp/sulla-proxy-params.conf; }
    location / {
      proxy_pass $console_upstream;
      include /tmp/sulla-proxy-params.conf;
    }
  }
  server {
    listen 8787${TLS_DIRECTIVES};
    server_name ${SULLA_VAULT_HOST};
    location / {
      proxy_pass $vault_public_upstream;
      include /tmp/sulla-proxy-params.conf;
    }
  }

}
