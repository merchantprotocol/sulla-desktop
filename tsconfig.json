{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Node",
    "moduleDetection": "force",
    "jsx": "react",
    "lib": [
      "ESNext",
      "ESNext.AsyncIterable",
      "DOM",
      "DOM.Iterable",
    ],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "sourceMap": true,
    "strict": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "@pkg/*": [
        "pkg/sulla-desktop/*"
      ],
      "@sulla/foundation/postgres": [
        "node_modules/@sulla/foundation/dist/drivers/postgres/index.d.ts"
      ],
      "@sulla/foundation/sqlite": [
        "node_modules/@sulla/foundation/dist/drivers/sqlite/index.d.ts"
      ],
      "@sulla/foundation/d1": [
        "node_modules/@sulla/foundation/dist/drivers/d1/index.d.ts"
      ],
      "@sulla/foundation/testing": [
        "node_modules/@sulla/foundation/dist/testing/index.d.ts"
      ]
    },
    "typeRoots": [
      "./node_modules",
      "./node_modules/@types"
    ],
    "types": [
      "@types/node"
    ]
  },
  "exclude": [
    "node_modules",
    "dist",
    "tailwind.config.js",
    "tailwind.config.cjs",
    "tailwind.config.mjs",
    "postcss.config.cjs",
    "scripts/lib/installer-*.tsx",
    "scripts/lib/installer-win32-gen.tsx"
  ],
  "include": [
    "**/*",
    "**/*.ts",
    "**/*.d.ts",
    "**/*.tsx",
    "**/*.vue",
    ".eslintrc.js"
  ]
}
