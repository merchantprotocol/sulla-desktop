events {}

http {
  resolver 127.0.0.11 valid=5s ipv6=off;
  resolver_timeout 2s;
  upstream accounts { zone accounts 64k; server accounts:3020 resolve; }

  upstream keycloak { zone keycloak 64k; server accounts:8080 resolve; }

  map $http_host $forwarded_port {
    ~:([0-9]+)$ $1;
    default 443;
  }

  server {
    listen 8787${TLS_DIRECTIVES};

    location = /healthz { proxy_pass http://accounts/healthz; }
    location = /readyz { proxy_pass http://accounts/readyz; }
    location ^~ /auth/realms/master/ { return 404; }
    location ^~ /auth/admin/ { return 404; }
    location ^~ /auth/realms/sulla/ { proxy_pass http://keycloak; proxy_set_header Host $http_host; proxy_set_header X-Forwarded-Host $http_host; proxy_set_header X-Forwarded-Port $forwarded_port; proxy_set_header X-Forwarded-Proto $scheme; proxy_set_header X-Forwarded-For $remote_addr; }
    location ^~ /auth/resources/ { proxy_pass http://keycloak; proxy_set_header Host $http_host; proxy_set_header X-Forwarded-Host $http_host; proxy_set_header X-Forwarded-Port $forwarded_port; proxy_set_header X-Forwarded-Proto $scheme; proxy_set_header X-Forwarded-For $remote_addr; }
    location ^~ /auth/ { return 404; }
    location = /.well-known/sulla-authority { proxy_pass http://accounts; proxy_set_header Host $http_host; proxy_set_header X-Forwarded-Host $http_host; proxy_set_header X-Forwarded-Port $forwarded_port; proxy_set_header X-Forwarded-Proto $scheme; proxy_set_header X-Forwarded-For $remote_addr; }
    location = /v1/authority/membership/resolve { proxy_pass http://accounts; proxy_set_header Host $http_host; proxy_set_header X-Forwarded-Host $http_host; proxy_set_header X-Forwarded-Port $forwarded_port; proxy_set_header X-Forwarded-Proto $scheme; proxy_set_header X-Forwarded-For $remote_addr; }
    location = /v1/oidc/callback { proxy_pass http://accounts; proxy_set_header Host $http_host; proxy_set_header X-Forwarded-Host $http_host; proxy_set_header X-Forwarded-Port $forwarded_port; proxy_set_header X-Forwarded-Proto $scheme; proxy_set_header X-Forwarded-For $remote_addr; }
    location = /v1/sessions/refresh { proxy_pass http://accounts; proxy_set_header Host $http_host; proxy_set_header X-Forwarded-Host $http_host; proxy_set_header X-Forwarded-Port $forwarded_port; proxy_set_header X-Forwarded-Proto $scheme; proxy_set_header X-Forwarded-For $remote_addr; }
    location = /v1/profile { proxy_pass http://accounts; proxy_set_header Host $http_host; proxy_set_header X-Forwarded-Host $http_host; proxy_set_header X-Forwarded-Port $forwarded_port; proxy_set_header X-Forwarded-Proto $scheme; proxy_set_header X-Forwarded-For $remote_addr; }
    location = /v1/connections { proxy_pass http://accounts; proxy_set_header Host $http_host; proxy_set_header X-Forwarded-Host $http_host; proxy_set_header X-Forwarded-Port $forwarded_port; proxy_set_header X-Forwarded-Proto $scheme; proxy_set_header X-Forwarded-For $remote_addr; }
    location ~ ^/v1/connections/[0-9a-fA-F-]+(?:/authorize)?$ { proxy_pass http://accounts; proxy_set_header Host $http_host; proxy_set_header X-Forwarded-Host $http_host; proxy_set_header X-Forwarded-Port $forwarded_port; proxy_set_header X-Forwarded-Proto $scheme; proxy_set_header X-Forwarded-For $remote_addr; }
    location / { return 404; }
  }
}
